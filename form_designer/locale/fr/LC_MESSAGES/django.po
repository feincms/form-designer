#: form_designer/models.py:88
msgid "Thank you, your input has been received."
msgstr "Merci, vos données ont bien été reçues."

#: form_designer/models.py:112
msgid "Save form submission"
msgstr "Enregistrer les données du formulaire"

#: form_designer/models.py:114
msgid ""
"Save form submissions in the database so that they may be exported later."
msgstr ""
"Enregistrer les données des formulaires dans la base de données pour qu’elles "
"puissent plus tard être exportées."

#: form_designer/models.py:123
msgid "Send email"
msgstr "Envoyer un courriel"

#: form_designer/models.py:125
msgid "Send the submitted form data to a list of email addresses."
msgstr "Envoyer les données des formulaires à une liste de courriels."

#: form_designer/models.py:134
msgid "Separate multiple email addresses with commas."
msgstr "Séparer les adresses de courriel par des virgules."

#: form_designer/models.py:142
msgid "subject"
msgstr "objet"

#: form_designer/models.py:144
#, python-format
msgid ""
"Defaults to the form title. Use %(fieldname)s to insert submitted values."
msgstr ""
"Par défaut, le titre du formulaire. Utilisez %(fieldname)s pour insérer les "
"valeurs envoyées."

#: form_designer/models.py:153
msgid "author's email field"
msgstr "champ courriel de l’auteur"

#: form_designer/models.py:155
msgid ""
"The author of the submission will be added to the Cc: if this is set to an "
"existing form field below."
msgstr ""
"L’auteur de l’envoi sera aouté au champ Cc: du courriel si cette valeur "
"correspond à un champ de formulaire existant ci-dessous."

#: form_designer/models.py:167
msgid "title"
msgstr "titre"

#: form_designer/models.py:168
msgid "config"
msgstr "config"

#: form_designer/models.py:295
msgid "removed field"
msgstr "champ supprimé"

#: form_designer/models.py:353
msgid ""
"Enter a value consisting only of lowercase letters, numbers, dashes and the "
"underscore."
msgstr ""
"Saisissez une valeur composée uniquement de lettres minuscules, de chiffres, "
"de tirets et de soulignements."

#: form_designer/models.py:362
msgid ""
"Data is saved using this name. Changing it may result in data loss. This "
"field only allows a-z, 0-9, - and _ as characters."
msgstr ""
"Les données sont enregistrées avec ce nom. En le modifiant, des données "
"pourraient être perdues. Ce champ n’autorise que les caractères a-z, 0-9, - "
"et _."

